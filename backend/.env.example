# Copy this file to .env and fill values locally. Never commit .env.
# ─── Environment ──────────────────────────────────────────────────────────────
APP_ENV=development
ENVIRONMENT=development
DEBUG=true

# ─── Railway provides PORT at runtime; only used for local dev fallback ───────
PORT=8000

# ─── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Use the asyncpg SQLAlchemy URL from the Neon Connect dialog.
# The backend auto-converts postgresql:// → postgresql+asyncpg:// at startup.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require
DEMO_DATA_MODE=false

# ─── AI Services (Groq) ──────────────────────────────────────────────────────
# Enables live Groq image reading and declaration extraction.
GROQ_API_KEY=
# Keep these defaults unless you intentionally select another Groq-supported model.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-20b
MOCK_AI_MODE=false

# ─── AI Services (Gemini – optional) ─────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a long unique value before any shared deployment.
JWT_SECRET=replace-with-a-long-random-secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins. Use "*" only for prototype/demo.
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ─── Storage ──────────────────────────────────────────────────────────────────
# Local filesystem path. Railway volumes can be mounted here for persistence.
STORAGE_ROOT=storage

# ─── Cloudinary Evidence Object Storage ───────────────────────────────────────
# Cloudinary credentials for permanent inspection evidence images (crops & overlays).
CLOUDINARY_ENABLED=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lm_trace/evidence
CLOUDINARY_SECURE=true
MAX_EVIDENCE_IMAGE_SIZE_MB=15

# ─── Railway Environment Variables (set in Railway dashboard, not here) ───────
# DATABASE_URL          → Neon connection string
# GROQ_API_KEY          → Groq API key
# GEMINI_API_KEY        → Gemini API key (if using Gemini)
# CLOUDINARY_CLOUD_NAME → Cloudinary cloud name
# CLOUDINARY_API_KEY    → Cloudinary API key
# CLOUDINARY_API_SECRET → Cloudinary API secret (NEVER expose to client)
# CLOUDINARY_FOLDER     → lm_trace/evidence
# CLOUDINARY_ENABLED    → true
# JWT_SECRET            → Long random secret
# CORS_ORIGINS          → "*" or comma-separated origins
# MOCK_AI_MODE          → false
# DEMO_DATA_MODE        → false
# APP_ENV               → production
# STORAGE_ROOT          → /app/storage (or Railway volume mount path)
